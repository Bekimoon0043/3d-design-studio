# Port the Express server listens on. Render sets PORT automatically in production.
PORT=4000

# Comma-separated list of allowed CORS origins (your deployed frontend URL(s))
CORS_ORIGIN=http://localhost:5173

# Supabase project (service role key is required ONLY if you extend the backend
# to perform privileged/admin operations, e.g. server-side asset processing).
# NEVER expose the service role key to the frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
